{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FormaForgeDT",
  "version": "0.1.0",
  "identifier": "com.formaforge.dt",
  "build": {
    "beforeDevCommand": "corepack pnpm --dir ../web dev --host 127.0.0.1",
    "beforeBuildCommand": "corepack pnpm --dir ../web build:desktop",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "FormaForgeDT",
      "width": 1440,
      "height": 900,
      "minWidth": 760,
      "minHeight": 640,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost https://fonts.googleapis.com https://fonts.gstatic.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8787"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "createUpdaterArtifacts": false
  }
}
