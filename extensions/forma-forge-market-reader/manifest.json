{
  "manifest_version": 3,
  "name": "FormaForge Market Reader",
  "version": "1.2.0",
  "minimum_chrome_version": "116",
  "description": "Read visible China marketplace prices and translate common commerce labels.",
  "action": {
    "default_title": "Mở FormaForge Market Reader"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "tabs"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.frankfurter.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.taobao.com/*",
        "https://*.tmall.com/*",
        "https://*.1688.com/*",
        "https://*.jd.com/*",
        "https://*.yangkeduo.com/*",
        "https://*.pinduoduo.com/*",
        "https://*.xiaohongshu.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
